{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "bmad-method",
  "version": "6.0.0-alpha.0",
  "description": "Breakthrough Method of Agile AI-driven Development",
  "keywords": [
    "agile",
    "ai",
    "orchestrator",
    "development",
    "methodology",
    "agents",
    "bmad"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmad-code-org/BMAD-METHOD.git"
  },
  "license": "MIT",
  "author": "Brian (BMad) Madison",
  "main": "tools/cli/bmad-cli.js",
  "bin": {
    "bmad": "tools/cli/bmad-cli.js"
  },
  "scripts": {
    "bmad:install": "node tools/cli/bmad-cli.js install",
    "bmad:serve": "node tools/cli/bmad-cli.js serve",
    "bmad:status": "node tools/cli/bmad-cli.js status",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd src/web && npm run build",
    "bundle": "node tools/cli/bundlers/bundle-web.js all",
    "flatten": "node tools/flattener/main.js",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,md,yaml}\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,json,md,yaml}\"",
    "install:bmad": "node tools/cli/bmad-cli.js install",
    "lint": "eslint . --ext .js,.cjs,.mjs,.yaml --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.cjs,.mjs,.yaml --fix",
    "prepare": "husky",
    "rebundle": "node tools/cli/bundlers/bundle-web.js rebundle",
    "release:major": "gh workflow run \"Manual Release\" -f version_bump=major",
    "release:minor": "gh workflow run \"Manual Release\" -f version_bump=minor",
    "release:patch": "gh workflow run \"Manual Release\" -f version_bump=patch",
    "release:watch": "gh run watch",
    "serve": "npm run build:backend && node tools/cli/bmad-cli.js serve",
    "validate:bundles": "node tools/validate-bundles.js"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "npm run lint:fix",
      "npm run format:fix"
    ],
    "*.yaml": [
      "eslint --fix",
      "npm run format:fix"
    ],
    "*.{json,md}": [
      "npm run format:fix"
    ]
  },
  "dependencies": {
    "@kayvan/markdown-tree-parser": "^1.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chokidar": "^2.1.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/glob": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.4.1",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "figlet": "^1.8.0",
    "fs-extra": "^11.3.0",
    "get-port": "^7.1.0",
    "glob": "^11.0.3",
    "ignore": "^7.0.5",
    "inquirer": "^8.2.6",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "ora": "^5.4.1",
    "semver": "^7.6.3",
    "uuid": "^9.0.1",
    "wrap-ansi": "^7.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/bcrypt": "^5.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^24.7.2",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-yml": "^1.18.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "lint-staged": "^16.1.1",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.5.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "yaml-eslint-parser": "^1.2.3",
    "yaml-lint": "^1.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
